# --- Telegram: bot-account mode (src/bot.py) ---
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your own Telegram numeric user id (message @userinfobot to get it).
# Used to gate owner commands (/pause, /status, ...) and conversation forwarding.
OWNER_CHAT_ID=

# --- Telegram: userbot mode (src/userbot.py) — logs into your REAL account ---
# Get these from https://my.telegram.org/apps (log in with your own phone number)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Comma-separated usernames or numeric ids that should NEVER get an auto-reply
# (e.g. family, anyone whose messages you always want to see and answer yourself).
# Match is case-insensitive, without the @ symbol. Example: sister_username,123456789
NEVER_AUTOREPLY=

# --- LLM ---
# gemini (free tier) or anthropic (paid, better persona fidelity)
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use. Gemini free tier: gemini-flash-lite-latest (much higher daily
# free quota than gemini-flash-latest, which caps at ~20 requests/day)
# If LLM_PROVIDER=anthropic use: claude-opus-4-8 (and set ANTHROPIC_API_KEY)
LLM_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=

# --- Behavior ---
# true  = never admits to being a bot, deflects in character
# false = honestly says it's Chirag's auto-reply assistant when directly asked
STAY_IN_CHARACTER=true

# Mirror every conversation to your own Telegram chat so you can review later
FORWARD_TO_OWNER=false

# Human-like delay range in seconds before replying
REPLY_DELAY_MIN=2
REPLY_DELAY_MAX=12
